{
  "name": "crud-api",
  "version": "1.0.0",
  "private": true,
  "description": "Fastify product catalog CRUD API",
  "scripts": {
    "build": "esbuild src/server.ts src/cluster.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist",
    "start:dev": "tsx watch src/server.ts",
    "start:prod": "npm run build && node dist/server.js",
    "start:multi": "npm run build && node dist/cluster.js",
    "test": "node --test --import tsx test/products.test.ts"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
